// Cloudflare Worker for www.siman.li: it only serves the built static site (no server code).
// Cloudflare builds it on every push to main: `npm run build` makes ./dist, then `npx wrangler deploy` uploads it.
{
  "name": "siman-li-site",
  "compatibility_date": "2025-11-01",
  "assets": {
    "directory": "./dist",
    // pages answer at /work/windloom (as every link on the site is written), not /work/windloom/
    "html_handling": "drop-trailing-slash"
  }
}

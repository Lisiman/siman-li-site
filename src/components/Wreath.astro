---
// A ring of pressed flowers around an oval portrait (Detail.memorial), as a child would lay them round a photo: daisies,
// violets, sprigs of baby's breath, Queen Anne's lace, fern and leaves, crowded and overlapping the edge, more of them at
// the bottom. Drawn in the site's ink line with a wash of colour; made once, at build time, the same every visit (seeded).
// The drawing is in the portrait's own units: the oval is 300 × 440, centred at (150, 220); the SVG reaches beyond it
// on every side and is laid over the picture (styles: .d-wreath).
const { seed = 11 } = Astro.props as { seed?: number };
let s0 = seed >>> 0;
const rnd = (): number => { s0 = (s0 * 1664525 + 1013904223) >>> 0; return s0 / 4294967296; };
const R = (lo: number, hi: number): number => lo + rnd() * (hi - lo);
const pick = <T,>(xs: T[]): T => xs[Math.floor(rnd() * xs.length)];
const f1 = (n: number): string => n.toFixed(1);
const CX = 150, CY = 220, RX = 150, RY = 220;
/** a point on the ring at angle t (0 = right, π/2 = bottom), pushed out by k (1 = on the oval's edge) */
const at = (t: number, k: number): [number, number] => [CX + Math.cos(t) * RX * k, CY + Math.sin(t) * RY * k];
/** an angle along the ring, with more of them toward the bottom */
const angle = (u: number): number => { const t = u * Math.PI * 2; return t + Math.sin(t) * 0.22; };
const deg = (t: number): number => (t * 180) / Math.PI;

const C = {
  violet: ['#6E57D8', '#8B63E3', '#5C79E0', '#A780EE'],
  pink: ['#F39AC6', '#EE7FB5', '#F7B6D2', '#E36FA6'],
  magenta: ['#C94AA8', '#B33E9C', '#D869C0'],
  red: ['#E1485F', '#D33553'],
  daisy: ['#F6F1E4', '#F7B9D6', '#CFA8F2', '#F6CF4E'],
  lace: ['#F6F1E4', '#F3C08A', '#E9A6E0'],
  green: ['#6FA669', '#5E9A5C', '#82B576'],
};
const ink = (d: string, extra = ''): string => `<path d="${d}"${extra} />`;
/** one flower or green, placed; it sways a little on its own slow rhythm (SMIL, round its stem or its heart, at 0,0) */
const g = (x: number, y: number, r: number, sc: number, body: string, sway = 3): string => {
  const a = R(sway * .6, sway), dur = R(3.2, 5.6), begin = -R(0, dur);
  const anim = `<animateTransform attributeName="transform" type="rotate" values="${f1(-a)};${f1(a)};${f1(-a)}" keyTimes="0;.5;1" calcMode="spline" keySplines=".45 0 .55 1;.45 0 .55 1" dur="${dur.toFixed(2)}s" begin="${begin.toFixed(2)}s" repeatCount="indefinite" />`;
  return `<g transform="translate(${f1(x)},${f1(y)}) rotate(${f1(r)}) scale(${sc.toFixed(2)})"><g>${anim}${body}</g></g>`;
};

// ---- the flowers and greens, each drawn at about 20 units, centred on 0,0
/** a daisy: many thin petals round a dotted disc */
const daisy = (): string => {
  const n = Math.round(R(13, 18)), c = pick(C.daisy); let p = '';
  for (let i = 0; i < n; i++) { const a = (i * 360) / n + R(-4, 4), l = R(8.5, 10.5); p += `<ellipse cx="0" cy="${f1(-l / 2 - 2.6)}" rx="1.6" ry="${f1(l / 2)}" transform="rotate(${f1(a)})" />`; }
  let dots = ''; for (let i = 0; i < 9; i++) { const a = R(0, 6.28), r = R(0, 2.2); dots += `<circle cx="${f1(Math.cos(a) * r)}" cy="${f1(Math.sin(a) * r)}" r=".35" />`; }
  return `<g fill="${c}" fill-opacity=".9">${p}</g><circle r="3.4" fill="#E8B23A" /><circle r="3.4" fill="none" /><g fill="#7A5420" stroke="none">${dots}</g>`;
};
/** a violet / verbena: five round petals with a notch, an eye in the middle */
const violet = (pal: string[]): string => {
  const c = pick(pal); let p = '';
  for (let i = 0; i < 5; i++) { const a = i * 72; p += `<path d="M0,0 C-5,-3 -6.5,-9 -2.6,-11 Q0,-9.5 2.6,-11 C6.5,-9 5,-3 0,0 Z" transform="rotate(${a})" />`; }
  return `<g fill="${c}" fill-opacity=".9">${p}</g><circle r="1.6" fill="#F6F1E4" /><circle r="1.6" fill="none" /><path d="M0,-1.6 V-4.5 M1.5,.5 L4,2 M-1.5,.5 L-4,2" stroke-opacity=".6" />`;
};
/** a sprig: a curving stem with little round buds along it (baby's breath, statice) */
const sprig = (pal: string[]): string => {
  const c = pick(pal), L = R(18, 28), bend = R(-6, 6); let buds = '';
  const n = Math.round(R(7, 12));
  for (let i = 0; i < n; i++) { const u = 0.25 + (i / n) * 0.8, x = bend * u * u + R(-3.5, 3.5), y = -L * u + R(-1.5, 1.5); buds += `<circle cx="${f1(x)}" cy="${f1(y)}" r="${f1(R(1.3, 2.3))}" />`; }
  return `<path d="M0,0 Q${f1(bend / 2)},${f1(-L / 2)} ${f1(bend)},${f1(-L)}" fill="none" stroke="${pick(C.green)}" stroke-opacity=".9" /><g fill="${c}" fill-opacity=".9">${buds}</g>`;
};
/** Queen Anne's lace: spokes from one point, a tiny bloom at the end of each */
const lace = (): string => {
  const c = pick(C.lace), n = Math.round(R(9, 13)); let sp = '', bl = '';
  for (let i = 0; i < n; i++) { const a = -Math.PI / 2 + (i / (n - 1) - 0.5) * 2.4, l = R(7, 10), x = Math.cos(a) * l, y = Math.sin(a) * l; sp += `M0,0 L${f1(x)},${f1(y)} `; bl += `<circle cx="${f1(x)}" cy="${f1(y)}" r="${f1(R(1.1, 1.7))}" />`; }
  return `<path d="${sp}M0,0 L0,8" fill="none" stroke-opacity=".7" /><g fill="${c}" fill-opacity=".95">${bl}</g>`;
};
/** a fern frond: a stem with paired leaflets, smaller toward the tip */
const fern = (): string => {
  const L = R(20, 30), n = 6; let lf = '';
  for (let i = 1; i <= n; i++) { const y = -(i / (n + 1)) * L, s = 1 - i / (n + 2), w = 5.5 * s, h = 2.2 * s + .6; lf += `<path d="M0,${f1(y)} q${f1(w * .6)},${f1(-h)} ${f1(w)},${f1(-h * .4)} q${f1(-w * .4)},${f1(h)} ${f1(-w)},${f1(h * .4)} Z M0,${f1(y)} q${f1(-w * .6)},${f1(-h)} ${f1(-w)},${f1(-h * .4)} q${f1(w * .4)},${f1(h)} ${f1(w)},${f1(h * .4)} Z" />`; }
  return `<g fill="${pick(C.green)}" fill-opacity=".85">${lf}</g><path d="M0,0 L0,${f1(-L)}" fill="none" />`;
};
/** a leaf: a pointed oval with a midrib and a few veins */
const leaf = (): string => {
  const L = R(12, 19), W = L * R(.32, .42);
  return `<path d="M0,0 C${f1(W)},${f1(-L * .3)} ${f1(W * .8)},${f1(-L * .8)} 0,${f1(-L)} C${f1(-W * .8)},${f1(-L * .8)} ${f1(-W)},${f1(-L * .3)} 0,0 Z" fill="${pick(C.green)}" fill-opacity=".85" /><path d="M0,-1 L0,${f1(-L * .85)} M0,${f1(-L * .35)} l${f1(W * .5)},${f1(-L * .12)} M0,${f1(-L * .35)} l${f1(-W * .5)},${f1(-L * .12)} M0,${f1(-L * .6)} l${f1(W * .4)},${f1(-L * .1)} M0,${f1(-L * .6)} l${f1(-W * .4)},${f1(-L * .1)}" fill="none" stroke-opacity=".7" />`;
};

// ---- laid round the ring: greens and sprigs underneath, poking outward; then a close ring of flowers right on the
// photo's edge, overlapping one another so no edge shows; then more flowers over them, a little out, heavier at the bottom
const under: string[] = [], edge: string[] = [], over: string[] = [];
const N_GREEN = 26, N_EDGE = 40, N_FLOWER = 12, Z = 1.75;   // Z: how big they are against the photo
for (let i = 0; i < N_GREEN; i++) {
  const t = angle(i / N_GREEN + R(-.012, .012)), [x, y] = at(t, R(1.04, 1.16));
  const out = deg(t) + 90 + R(-55, 55);   // pointing away from the photo, give or take
  const kind = rnd();
  if (kind < .35) under.push(g(x, y, out, Z * R(.8, 1.15), fern(), 5));
  else if (kind < .65) under.push(g(x, y, out, Z * R(.8, 1.1), leaf(), 5));
  else under.push(g(x, y, out, Z * R(.85, 1.15), sprig(pick([C.magenta, C.pink, C.red, C.violet])), 6));
}
const bloom = (x: number, y: number, t: number, sc: number): string => {
  const k = rnd();
  if (k < .34) return g(x, y, R(0, 360), sc * 1.05, daisy(), 4);
  if (k < .74) return g(x, y, R(0, 360), sc * .92, violet(pick([C.violet, C.pink, C.magenta])), 4);
  if (k < .86) return g(x, y, deg(t) + 90 + R(-30, 30), sc, lace(), 5);
  return g(x, y, R(0, 360), sc * .88, violet([pick(C.red)]), 4);
};
for (let i = 0; i < N_EDGE; i++) {
  const t = (i / N_EDGE) * Math.PI * 2 + R(-.02, .02), [x, y] = at(t, R(.985, 1.015));
  edge.push(bloom(x, y, t, Z * R(.82, 1.02) * (Math.sin(t) > .35 ? 1.1 : 1)));
}
for (let i = 0; i < N_FLOWER; i++) {
  const t = angle(i / N_FLOWER + R(-.01, .01)), [x, y] = at(t, R(1.04, 1.12));
  over.push(bloom(x, y, t, Z * R(.6, .95) * (Math.sin(t) > .35 ? 1.15 : 1)));
}
// light drifting off the flowers: tiny motes rise from the ring and float outward a little way, fading in and out,
// each on its own slow time (styles: .d-spark)
const SPARK = ['#FFF4D8', '#FFE2B0', '#FFD0DE', '#FFF9EC'];
let sparks = '', more = '';
// 200 always; 200 more that only come once the lamp below is lit (.d-spark--more, styles)
for (let i = 0; i < 400; i++) {   // (five times the first try, and as many again once lit)
  const t = R(0, Math.PI * 2), [x, y] = at(t, R(.98, 1.1)), out = t + R(-.5, .5), dist = R(60, 160);
  const c = `<circle class="d-spark" cx="${f1(x)}" cy="${f1(y)}" r="${f1(R(2, 4))}" fill="${pick(SPARK)}" style="--dx:${f1(Math.cos(out) * dist)}px;--dy:${f1(Math.sin(out) * dist - R(15, 40))}px;--d:${R(6, 11).toFixed(2)}s;--dl:${(-R(0, 11)).toFixed(2)}s;--o:${R(.35, .7).toFixed(2)}" />`;
  if (i < 200) sparks += c; else more += c;
}
const svg = `<g class="d-sparks">${sparks}<g class="d-sparks-more">${more}</g></g><g class="d-wreath-ink" fill="none" stroke-linecap="round" stroke-linejoin="round">${under.join('')}${edge.join('')}${over.join('')}</g>`;
---
<svg class="d-wreath" viewBox="-60 -60 420 560" aria-hidden="true" set:html={svg}></svg>
<script>
  // still flowers for anyone who asks for less motion
  if (matchMedia('(prefers-reduced-motion: reduce)').matches) document.querySelectorAll<SVGSVGElement>('.d-wreath').forEach((s) => s.pauseAnimations());
</script>

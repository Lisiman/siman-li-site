---
// Rows of pictures on a work's page: one (full width), two (side by side, the same height) or more across.
// Used by work/[slug].astro for the gallery and for the pictures after the film.
import type { GalleryItem } from '../data/details';
const { rows, chapters = [], from = 0 } = Astro.props as { rows: GalleryItem[][]; /** headings before rows (their positions in the whole gallery) */ chapters?: { row: number; title: string; note?: string }[]; /** the position of the first of these rows in the whole gallery */ from?: number };
const chapterAt = (r: number) => chapters.find((c) => c.row === from + r);
---
{rows.map((row, r) => (<>
{chapterAt(r) && <h2 class="d-chapter">{chapterAt(r)!.title}</h2>}
{chapterAt(r)?.note && <p class="d-gallery-note d-chapter-note">{chapterAt(r)!.note}</p>}
<div class={`d-row d-row--${row.length}`}>
  {row.map((m, i) => (
    <figure class={m.small ? 'is-small' : (row.length === 2 && (m.fill || (i === 1 && !row.some((x) => x.fill)))) ? 'is-fill' : undefined} style={[m.small && m.at ? `grid-column: ${m.at} / span 2` : m.span ? `grid-column: ${m.at ?? 'auto'} / span ${m.span}` : '', m.bg ? `--bg-card:${m.bg}` : '', m.ratio ? `--ratio:${m.ratio}` : '', m.pos ? `--pos:${m.pos}` : '', m.scale ? `--scale:${m.scale}` : '', m.filter ? `--filter:${m.filter}` : ''].filter(Boolean).join(';') || undefined} data-ratio={m.ratio ? '' : undefined} data-scale={m.scale ? '' : undefined} data-filter={m.filter ? '' : undefined} data-bleed={m.bleed ? '' : undefined} data-card={m.bg ? '' : undefined} data-span={m.span ? '' : undefined}>
      {m.kind === 'video'
        ? <video src={m.src} poster={m.poster} width={m.w} height={m.h} autoplay muted loop playsinline></video>
        : <img src={m.src} alt={m.alt ?? ''} width={m.w} height={m.h} loading="lazy" decoding="async" />}
      {m.caption && <figcaption>{m.caption}</figcaption>}
    </figure>
  ))}
</div>
</>))}
